{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SaleManteiner",
  "version": "0.1.1",
  "identifier": "com.salemanteiner.desktop",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd .. && npm --workspace web run dev",
    "beforeBuildCommand": "cd .. && npm --workspace web run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SaleManteiner",
        "width": 1280,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyNUQ3OEEzNjhDMEM5QkYKUldTL3ljQm9vM2hkVW5yWXFodGR6ck1wZkk2MlQyOUczRUM4cnlIWVRWcHBNck5YV3FsWmZWeVYK",
      "endpoints": [
        "https://github.com/RicardoD4W/SaleManteiner/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/salemanteiner-server"],
    "windows": {
      "nsis": {
        "languages": ["Spanish"]
      }
    },
    "resources": {
      "resources/server": "server",
      "resources/web": "web"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
