{
  "name": "salemanteiner",
  "version": "0.1.0",
  "private": true,
  "description": "App web local para registrar y mantener un histórico de ventas de Wallapop",
  "type": "module",
  "workspaces": [
    "web",
    "server",
    "desktop"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:web": "npm run write:versions && npm --workspace web run dev",
    "dev:server": "npm --workspace server run dev",
    "dev:desktop": "npm --workspace desktop run dev",
    "build": "npm-run-all build:server build:web",
    "build:web": "npm run write:versions && npm --workspace web run build",
    "build:server": "npm --workspace server run build",
    "build:desktop": "npm --workspace desktop run build:app",
    "publish:new-version": "npm --workspace desktop run publish:new-version",
    "write:versions": "node scripts/write-versions.mjs",
    "typecheck": "npm-run-all typecheck:web typecheck:server",
    "typecheck:web": "npm --workspace web run typecheck",
    "typecheck:server": "npm --workspace server run typecheck",
    "lint": "npm-run-all lint:*",
    "lint:web": "npm --workspace web run lint",
    "lint:server": "npm --workspace server run lint",
    "test": "npm-run-all test:web test:server",
    "test:web": "npm --workspace web run test",
    "test:server": "npm --workspace server run test",
    "test:e2e": "npm --workspace web run e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
